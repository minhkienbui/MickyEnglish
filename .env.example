# Database connection string (PostgreSQL - Neon / Supabase / Local PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/micky_english?schema=public"

# NextAuth.js Configuration
NEXTAUTH_URL="http://localhost:3100"
NEXTAUTH_SECRET="micky-english-super-secret-jwt-key-2026-very-secure"

# Google OAuth Provider (Optional - Lấy từ Google Cloud Console)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Cloudinary / Supabase Storage (Optional - Lưu trữ Audio)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Email Configuration (Optional - Reset Password với Resend / Nodemailer)
EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="your-email@gmail.com"
EMAIL_SERVER_PASSWORD="your-app-password"
EMAIL_FROM="Micky English <noreply@mickyenglish.com>"
